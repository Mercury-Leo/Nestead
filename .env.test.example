# Credentials for the Supabase contract test. Copy to .env.test and fill in.
# .env.test is gitignored and is loaded only in test mode, so nothing here
# reaches a production build. Do NOT put these in .env.local, which IS loaded
# for builds and would inline them into the public bundle.
#
# Setup, once:
#   1. Supabase dashboard -> Authentication -> Users -> Add user.
#      Create TWO users with "Auto Confirm User" ticked, so no email is needed.
#      Use throwaway addresses and throwaway passwords: the suite deletes every
#      task and column in both their families between cases.
#   2. Fill this file in and rename it .env.test.
#   3. npm test
#
# The suite creates a family for each user on its first run, so there is
# nothing else to set up. Without this file the suite skips and npm test stays
# green.

SUPABASE_TEST_URL=
SUPABASE_TEST_ANON_KEY=

SUPABASE_TEST_A_EMAIL=
SUPABASE_TEST_A_PASSWORD=

SUPABASE_TEST_B_EMAIL=
SUPABASE_TEST_B_PASSWORD=
