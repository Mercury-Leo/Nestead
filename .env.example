# Which data backend src/data/index.ts should build.
# "local"    -> demo mode: browser localStorage, no accounts, pick who you are
# "supabase" -> real accounts and a shared database
# `npm run build` refuses anything but "supabase" (with the two values below
# filled in), so demo mode cannot be deployed by accident. For a deliberate
# demo build: npx vite build --mode demo
VITE_BACKEND=local

# Supabase connection details, used when VITE_BACKEND=supabase.
# Only the ANON key may ever appear here or in any VITE_* variable: every VITE_*
# value is inlined into the JavaScript bundle and is therefore public.
# NEVER put a service-role key (or any other secret) in this file.
VITE_SUPABASE_URL=
# The publishable key (sb_publishable_...), which newer projects issue in place
# of the legacy anon JWT. Public by design; safe ONLY because RLS gates every
# table. Never the secret key (sb_secret_..., formerly service_role).
VITE_SUPABASE_ANON_KEY=
