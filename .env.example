# Which data backend src/data/index.ts should build.
# "local"    -> demo mode: browser localStorage, no accounts, pick who you are
# "supabase" -> real accounts and a shared database
# `npm run build` refuses anything but "supabase" (with the two values below
# filled in), so demo mode cannot be deployed by accident. For a deliberate
# demo build: npx vite build --mode demo
VITE_BACKEND=local

# Supabase connection details, used when VITE_BACKEND=supabase.
# Only the ANON key may ever appear here or in any VITE_* variable: every VITE_*
# value is inlined into the JavaScript bundle and is therefore public.
# NEVER put a service-role key (or any other secret) in this file.
VITE_SUPABASE_URL=
# The publishable key (sb_publishable_...), which newer projects issue in place
# of the legacy anon JWT. Public by design; safe ONLY because RLS gates every
# table. Never the secret key (sb_secret_..., formerly service_role).
VITE_SUPABASE_ANON_KEY=

# "Search online" on the import screen (server/search). A free Tavily key from
# https://tavily.com: 1,000 searches a month, no card. SERVER-ONLY: vite.config.ts
# hands it to /api/search under `npm run dev` and `vite preview`; production
# reads the same name as a secret on the Cloudflare Pages project. Never give it
# a VITE_ prefix, which would publish it in the bundle. Left empty, search falls
# back to the recipes that ship with the app.
TAVILY_API_KEY=

# AI recipe reading (server/ai). All SERVER-ONLY: never give them a VITE_ prefix.
# Free tier: a key from https://openrouter.ai/keys on an account with no credit
# bought, shared by the whole app (50 requests a day; Nestead stops at 45).
OPENROUTER_API_KEY=
# Comma-separated :free model ids, first three used, tried in order. Pick ones
# with structured outputs: https://openrouter.ai/models?supported_parameters=structured_outputs
# Free models come and go, so this lives here rather than in the code.
OPENROUTER_FREE_MODELS=
# Encrypts families' own OpenRouter keys. 32 random bytes, base64:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Use your own locally, never production's: dev and production share the
# Supabase project, so keys saved locally only decrypt locally (save them to
# the test families only).
AI_KEY_SECRET=
# Production only (Cloudflare Pages variables): SUPABASE_URL and
# SUPABASE_ANON_KEY, the same values as VITE_SUPABASE_URL and
# VITE_SUPABASE_ANON_KEY. Locally the dev server passes those two on.
