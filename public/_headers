# Cloudflare Pages response headers. Pages otherwise sends
# `max-age=0, must-revalidate` for everything, so each launch of the app
# re-checks every script, stylesheet and font with the server.

# Vite names every file here after a hash of its contents, so a file at a given
# path never changes: a new build writes new names. Keep them for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Fixed names that change rarely. A day, then re-check.
/icons/*
  Cache-Control: public, max-age=86400
/manifest.webmanifest
  Cache-Control: public, max-age=86400

# index.html and client routes keep the default, so a deploy is picked up on
# the next launch.
